{
  "name": "stormcam",
  "private": true,
  "version": "0.1.0",
  "description": "STORMCAM \u2014 a first-person storm-chasing game that looks like real dashcam footage. Three.js + TypeScript + Vite.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "deploy": "bash scripts/deploy-play.sh"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
